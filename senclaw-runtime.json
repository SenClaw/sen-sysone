{
  "schemaVersion": 1,
  "id": "sen-sysone",
  "name": "SenClaw Decision (System One)",
  "version": "0.1.2",
  "description": "Typed choice/score/noul decisions from a local Laya checkpoint (ONNX Runtime) or a hosted Jev-compatible backend",
  "type": "decision",
  "slots": ["decision"],
  "formats": [],
  "capabilities": ["decision"],
  "platforms": ["darwin-arm64", "linux-x64", "linux-arm64", "windows-x64", "windows-arm64"],
  "mode": "service",
  "entry": {
    "command": "bin/sen-sysone",
    "args": ["serve", "--host", "{host}", "--port", "{port}"],
    "env": {}
  },
  "health": { "path": "/health", "startupTimeoutSecs": 60 },
  "idleTimeoutSecs": 300,
  "api": { "openaiBase": "/v1" },
  "homepage": "https://github.com/SenClaw/sen-sysone",
  "releaseNotesUrl": "https://github.com/SenClaw/sen-sysone/releases/tag/v0.1.2",
  "license": "MIT"
}
